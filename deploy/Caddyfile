# Caddy reverse proxy for a self-hosted Mozhi instance, with automatic HTTPS.
#
# With docker compose (`--profile https`), the {$...} placeholders come from
# .env: MOZHI_DOMAIN must be a DNS name that points at this host, with ports
# 80 and 443 reachable from the internet, so Caddy can get a Let's Encrypt /
# ZeroSSL certificate.
#
# Caddy installed directly on the host instead? Use this file as is and set
# MOZHI_UPSTREAM=localhost:3000 (and OLLAMA_UPSTREAM=localhost:11434), or
# replace the placeholders with literal values.
{
	# Optional: an address for certificate expiry notices.
	# email you@example.com
}

# The on-device model mirror at /models/: the files tool/mirror_models.py
# downloads (MOZHI_MODELS_DIR in .env, mounted at /srv/models), for the
# app's Settings > Translation engines > Model source (Custom mirror
# https://<MOZHI_DOMAIN>/models/, or "This web server" for a web app served
# from the same site). Every file is checked against the SHA-256 built into
# the app, so serving them needs no trust; it keeps your users' IP
# addresses and languages away from Google, GitHub and Hugging Face.
# Plain static files with Range support (resumed downloads), CORS for web
# apps on other origins, and no directory listings.
(models) {
	handle_path /models/* {
		root * /srv/models
		@preflight method OPTIONS
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
			Access-Control-Allow-Headers "Range"
			Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges, ETag"
			# A day, then revalidated (ETag): Whisper and Tesseract files keep
			# their names when the catalogue moves to a new version.
			Cache-Control "public, max-age=86400"
			X-Content-Type-Options "nosniff"
			-Server
		}
		respond @preflight 204
		# Partial downloads of the mirror tool and hidden files stay private.
		file_server {
			hide .* *.part
		}
	}
}

{$MOZHI_DOMAIN:localhost} {
	import models

	reverse_proxy {$MOZHI_UPSTREAM:mozhi:3000}

	# Mozhi rejects request bodies over 4 MB (image translation uploads);
	# fail early with the same limit.
	request_body {
		max_size 4MiB
	}

	# Mozhi already sends HSTS, CSP and the other security headers; just drop
	# the version banner.
	header -Server
}

# Optional: Ollama over HTTPS, protected by an API key (Ollama itself has no
# authentication). Set OLLAMA_DOMAIN and a long random OLLAMA_API_KEY in .env,
# uncomment the block, and in the app add the Ollama provider with base URL
# https://<OLLAMA_DOMAIN> and the same key as its API key (the app sends it as
# "Authorization: Bearer <key>"). Native apps only: browsers send CORS
# preflight requests without the key, so the web app cannot use this.
#
# {$OLLAMA_DOMAIN:ollama.localhost} {
# 	@unauthorized not header Authorization "Bearer {$OLLAMA_API_KEY}"
# 	respond @unauthorized "Unauthorized" 401
#
# 	reverse_proxy {$OLLAMA_UPSTREAM:ollama:11434} {
# 		header_up Host localhost:11434
# 		# Streamed answers should not be buffered.
# 		flush_interval -1
# 	}
# }

# Optional: the Mozhi web app (the release's mozhi-<version>-web.zip,
# unpacked into MOZHI_WEB_DIR, mounted at /srv/mozhi-web) on its own domain,
# with the model mirror next to it, so the web app's default model source
# ("This web server") works. Set MOZHI_APP_DOMAIN in .env and uncomment.
# Use a domain of its own: other pages on the same origin could read the
# web app's storage (docs/security.md).
#
# {$MOZHI_APP_DOMAIN:app.localhost} {
# 	import models
#
# 	root * /srv/mozhi-web
# 	# index.html must not be cached for long, or updates are not picked up.
# 	@index path / /index.html /flutter_bootstrap.js /flutter_service_worker.js
# 	header @index Cache-Control "no-cache"
# 	header -Server
# 	file_server
# }

# Optional: HTTPS on your LAN without a public domain. Caddy creates its own
# certificate authority; install its root certificate (inside the container:
# /data/caddy/pki/authorities/local/root.crt) on your devices. Note: the Mozhi
# app does NOT trust private CAs (release builds trust system CAs only), so
# this only helps browsers and other clients. For the app, use plain http on
# your LAN, a VPN, or a publicly trusted certificate (ACME DNS challenge).
#
# mozhi.lan {
# 	tls internal
# 	reverse_proxy {$MOZHI_UPSTREAM:mozhi:3000}
# }
