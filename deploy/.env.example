# Copy to .env (next to docker-compose.yml) and edit. Every line is optional;
# commented values show the defaults.

# --- Profiles ----------------------------------------------------------------
# Extra services to start with a plain `docker compose up -d`:
#   ai     Ollama (local AI models)
#   libre  LibreTranslate (also set MOZHI_LIBRETRANSLATE_ENABLED=true)
#   https  Caddy with automatic HTTPS (also set MOZHI_DOMAIN)
# COMPOSE_PROFILES=ai,libre,https

# --- Mozhi -------------------------------------------------------------------
# Address and port Mozhi is published on. Use 127.0.0.1 when only Caddy (the
# https profile) or another local reverse proxy should reach it.
# MOZHI_BIND_ADDRESS=0.0.0.0
# MOZHI_PUBLISHED_PORT=3000

# Engines: an engine is on when its variable is "true" (the default here) and
# off for any other value.
# MOZHI_GOOGLE_ENABLED=true
# MOZHI_DEEPL_ENABLED=true
# MOZHI_REVERSO_ENABLED=true
# MOZHI_YANDEX_ENABLED=true
# MOZHI_MYMEMORY_ENABLED=true
# MOZHI_DUCKDUCKGO_ENABLED=true

# LibreTranslate: the URL points at the `libre` profile's container. Use your
# own server's URL instead if you run LibreTranslate elsewhere.
# MOZHI_LIBRETRANSLATE_ENABLED=false
# MOZHI_LIBRETRANSLATE_URL=http://libretranslate:5000

# Defaults of Mozhi's own web page (the app picks engines and languages
# itself).
# MOZHI_DEFAULT_ENGINE=google
# MOZHI_DEFAULT_SOURCE_LANG=auto
# MOZHI_DEFAULT_TARGET_LANG=en
# MOZHI_DEFAULT_PREFER_AUTODETECT=false

# User agent Mozhi sends to the engines (default: a desktop Chrome string).
# MOZHI_USER_AGENT=

# --- LibreTranslate (profile: libre) -------------------------------------------
# Languages to load. Unset = all of them (several GB, slow first start). The
# list below is what Mozhi offers for its LibreTranslate engine.
# LT_LOAD_ONLY=en,ar,zh,fr,de,hi,id,ga,it,ja,ko,pl,pt,ru,es,tr,vi

# --- Ollama (profile: ai) ---------------------------------------------------
# OLLAMA_BIND_ADDRESS=0.0.0.0
# OLLAMA_PUBLISHED_PORT=11434
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_CONTEXT_LENGTH=8192
# Only for the Mozhi web app: the origin it is served from (or *).
# OLLAMA_ORIGINS=https://translate.example.com

# --- Caddy (profile: https) -------------------------------------------------
# A DNS name pointing at this server (ports 80 and 443 open).
# MOZHI_DOMAIN=mozhi.example.com
# The on-device model mirror served at https://<MOZHI_DOMAIN>/models/ (filled
# by the `mirror` profile: docker compose --profile mirror run --rm mirror).
# MOZHI_MODELS_DIR=./models
# Optional web app site (uncomment its block in Caddyfile first): its own
# domain and the unpacked mozhi-<version>-web.zip.
# MOZHI_APP_DOMAIN=translate.example.com
# MOZHI_WEB_DIR=./web
# Optional Ollama site (uncomment its block in Caddyfile first).
# OLLAMA_DOMAIN=ollama.example.com
# OLLAMA_API_KEY=change-me-to-a-long-random-string
