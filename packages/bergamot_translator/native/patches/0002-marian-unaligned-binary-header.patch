+// Copy a T from current (which need not be aligned for T: the 64-bit fields
+// after the item names and shapes are not, and 32-bit ARM faults on
+// unaligned 64-bit loads) and move forward past it.
+template <typename T>
+T read(const void*& current) {
+  T value;
+  std::memcpy(&value, current, sizeof(T));
+  current = (const char*)current + sizeof(T);
+  return value;
+}
