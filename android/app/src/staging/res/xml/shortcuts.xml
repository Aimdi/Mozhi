<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcuts (long-press the app icon), referenced from
     MainActivity's android.app.shortcuts meta-data. MainActivity turns
     mozhi://<screen> into the route /<screen> and forwards the
     TRANSLATE_CLIPBOARD action to Dart as {action: "translateClipboard"}
     when it arrives through the non-exported alias TranslateClipboardActivity
     (shortcuts are started with Mozhi's own identity, so the alias works;
     other apps can't reach it).
     Most launchers (Launcher3, Pixel) show only the first four, so those are
     the four quickest ways into a translation from outside the app:
     1. Translate clipboard: text copied in another app, translated at once.
     2. Camera (mozhi://image?source=camera, the home-screen widget's Camera
        button): signs, menus and labels, the camera opens on arrival.
     3. Conversation: two people talking, when there is no time to look for
        a tab.
     4. Translate screen (ScreenTranslateActivity): another app's screen.
     Then the other tabs, one tap away inside the app anyway: Dictionary
     (fifth, for launchers that show five) and Proofread (sixth: Android 10
     and later publish more per activity, getMaxShortcutCountPerActivity();
     Android 7 to 9 publish five and leave it out). Assistants and
     automation apps list them all.
     Static shortcuts can't follow the user's own tab order.
     test/platform/android_resources_test.dart checks that the copies agree
     and that every link opens its screen.
     Keep all three copies (main, staging, development) in sync.
     staging override of src/main/res/xml/shortcuts.xml: identical except
     android:targetPackage, which must be the literal applicationId
     (io.github.aimdi.mozhi.stg). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="translate_clipboard"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_clipboard"
        android:shortcutShortLabel="@string/shortcut_clipboard_short"
        android:shortcutLongLabel="@string/shortcut_clipboard_long">
        <intent
            android:action="io.github.aimdi.mozhi.action.TRANSLATE_CLIPBOARD"
            android:targetPackage="io.github.aimdi.mozhi.stg"
            android:targetClass="io.github.aimdi.mozhi.TranslateClipboardActivity" />
    </shortcut>
    <!-- Camera translate: the labels of the widget's Camera button. -->
    <shortcut
        android:shortcutId="camera"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_camera"
        android:shortcutShortLabel="@string/widget_camera_label"
        android:shortcutLongLabel="@string/widget_camera_description">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="mozhi://image?source=camera"
            android:targetPackage="io.github.aimdi.mozhi.stg"
            android:targetClass="io.github.aimdi.mozhi.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="conversation"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_conversation"
        android:shortcutShortLabel="@string/shortcut_conversation_short"
        android:shortcutLongLabel="@string/shortcut_conversation_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="mozhi://conversation"
            android:targetPackage="io.github.aimdi.mozhi.stg"
            android:targetClass="io.github.aimdi.mozhi.MainActivity" />
    </shortcut>
    <!-- Translate screen (ScreenTranslateActivity, not exported; shortcuts
         start with Mozhi's identity): fourth, so launchers that show four
         show it. -->
    <shortcut
        android:shortcutId="translate_screen"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_translate_screen"
        android:shortcutShortLabel="@string/shortcut_translate_screen_short"
        android:shortcutLongLabel="@string/shortcut_translate_screen_long">
        <intent
            android:action="io.github.aimdi.mozhi.action.TRANSLATE_SCREEN"
            android:targetPackage="io.github.aimdi.mozhi.stg"
            android:targetClass="io.github.aimdi.mozhi.ScreenTranslateActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="dictionary"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_dictionary"
        android:shortcutShortLabel="@string/shortcut_dictionary_short"
        android:shortcutLongLabel="@string/shortcut_dictionary_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="mozhi://dictionary"
            android:targetPackage="io.github.aimdi.mozhi.stg"
            android:targetClass="io.github.aimdi.mozhi.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="proofread"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_proofread"
        android:shortcutShortLabel="@string/shortcut_proofread_short"
        android:shortcutLongLabel="@string/shortcut_proofread_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="mozhi://proofread"
            android:targetPackage="io.github.aimdi.mozhi.stg"
            android:targetClass="io.github.aimdi.mozhi.MainActivity" />
    </shortcut>
</shortcuts>
