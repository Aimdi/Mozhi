<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Mozhi instances and AI providers (including LAN servers over http). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Voice input (speech_to_text). Requested at runtime when the user taps
         the microphone. BLUETOOTH_CONNECT is deliberately not declared: the
         plugin then simply skips Bluetooth headset routing instead of asking
         for the "Nearby devices" permission. CAMERA is not declared either:
         image_picker hands photos off to the system camera app
         (ACTION_IMAGE_CAPTURE), which needs no permission unless CAMERA is
         declared. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- RECORD_AUDIO implies a required microphone; keep the app installable
         on devices without one (voice input is optional). -->
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!-- Backup policy ("history stays on device", reviews/security.md W7):
         - No cloud backup (allowBackup="false"): history, settings and API
           keys never go to Google Drive.
         - Android 12+ still allows device-to-device transfer when setting up
           a new phone; res/xml/data_extraction_rules.xml lets settings and
           history move with the user but excludes flutter_secure_storage's
           files (API keys): their AndroidKeyStore wrapping keys never leave
           the device, so a copy could not be decrypted anyway.
         - res/xml/backup_rules.xml (Android 11 and lower) mirrors the
           exclusions in case backups are ever re-enabled. -->
    <application
        android:label="${appName}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
                />
            <!-- Hand mozhi:// links to the router. MainActivity rewrites them to
                 plain routes first (mozhi://image?x=1 -> /image?x=1). -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />
            <!-- Static launcher shortcuts (long-press the app icon). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Share sheet: "Share" text to Mozhi. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- Text selection toolbar: "Translate with Mozhi". -->
            <intent-filter android:label="@string/translate_with_mozhi">
                <action android:name="android.intent.action.PROCESS_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- Deep links: mozhi://<screen>[/<path>][?<query>] opens /<screen>…,
                 e.g. mozhi://translate?text=hola&from=es&to=en, mozhi://image,
                 mozhi://proofread?text=… or mozhi://dictionary?word=gato&from=es.
                 The <data> elements of one filter combine, so this matches
                 scheme "mozhi" with any of the listed hosts. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="mozhi"/>
                <data android:host="translate"/>
                <data android:host="image"/>
                <data android:host="conversation"/>
                <data android:host="proofread"/>
                <data android:host="documents"/>
                <data android:host="web"/>
                <data android:host="dictionary"/>
            </intent-filter>
        </activity>
        <!-- Quick Settings tile "Translate": opens Mozhi and translates the
             clipboard (MainActivity action TRANSLATE_CLIPBOARD). -->
        <service
            android:name=".TranslateTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_translate"
            android:label="@string/tile_translate_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Package visibility (Android 11+), see
         https://developer.android.com/training/package-visibility -->
    <queries>
        <!-- Opening links in a browser (url_launcher). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Used by the Flutter engine (io.flutter.plugin.text.ProcessTextPlugin)
             to list apps that can process selected text. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Sharing text (share_plus). -->
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Speech recognizers (speech_to_text). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Text-to-speech engines (flutter_tts). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- Camera apps for camera translate (image_picker). -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
</manifest>
