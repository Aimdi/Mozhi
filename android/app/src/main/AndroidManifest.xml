<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Mozhi instances and AI providers (including LAN servers over http). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Whether the active network is metered (ConnectivityManager
         .isActiveNetworkMetered, MainActivity.kt), so Wi-Fi-only offline
         model downloads ask before using mobile data. A normal permission:
         granted at install, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Voice input (speech_to_text). Requested at runtime when the user taps
         the microphone. BLUETOOTH_CONNECT is deliberately not declared: the
         plugin then simply skips Bluetooth headset routing instead of asking
         for the "Nearby devices" permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- RECORD_AUDIO implies a required microphone; keep the app installable
         on devices without one (voice input is optional). -->
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- Live camera (LiveCameraPlugin.kt, Camera2): the preview and its
         frames, read on the phone and never stored or sent (only the
         recognised text goes to the live engine). Requested at run time
         when the live view opens. Declaring it also makes image_picker's
         "Take photo" (the system camera app, ACTION_IMAGE_CAPTURE) ask for
         it first, as Android requires then. Not required: the app stays
         installable on devices without a camera (CAMERA alone would imply
         a required back camera with autofocus to app stores). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <!-- App lock (AppLockPlugin.kt): the framework BiometricPrompt asks for
         a fingerprint, face or the screen lock. A normal permission:
         granted at install, no prompt. Nothing else is needed (the screen
         lock fallback, KeyguardManager, needs no permission). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Translate screen (ScreenTranslateActivity.kt, docs/privacy.md):
         - FOREGROUND_SERVICE + FOREGROUND_SERVICE_MEDIA_PROJECTION: the one
           screenshot is taken by a foreground service of the type
           mediaProjection (ScreenCaptureService), after the system's
           screen-capture consent, which Android asks every time.
         - SYSTEM_ALERT_WINDOW ("Display over other apps") +
           FOREGROUND_SERVICE_SPECIAL_USE: the opt-in translate bubble
           (TranslateBubbleService). Granted by the user in Android's
           settings, only when the bubble is turned on.
         - POST_NOTIFICATIONS (Android 13+): asked only when the bubble is
           turned on, for its notification with Stop. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Backup policy ("history stays on device", reviews/security.md W7,
         docs/audit/2026-audit.md):
         - No cloud backup (allowBackup="false"): history, settings, API keys
           and offline models never go to Google Drive.
         - Android 12+ still allows device-to-device transfer when setting up
           a new phone even then; res/xml/data_extraction_rules.xml excludes
           every domain from it (and from cloud backup), so nothing moves.
           The history is also encrypted with a key kept in
           flutter_secure_storage (AndroidKeyStore-wrapped, device-bound).
         - res/xml/backup_rules.xml (Android 11 and lower) mirrors the
           exclusions in case backups are ever re-enabled.
         localeConfig lists the app's languages for Android 13+'s per-app
         language setting (res/xml/locales_config.xml). -->
    <application
        android:label="${appName}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
                />
            <!-- Hand mozhi:// links to the router. MainActivity rewrites them to
                 plain routes first (mozhi://image?x=1 -> /image?x=1). -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />
            <!-- Static launcher shortcuts (long-press the app icon). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- The share sheet goes to .ShareReceiverActivity and text
                 selections to .QuickTranslateActivity, which hand them on
                 to this activity (explicit intents need no filter here). -->
            <!-- Deep links: mozhi://<screen>[/<path>][?<query>] opens /<screen>…,
                 e.g. mozhi://translate?text=hola&from=es&to=en, mozhi://image,
                 mozhi://proofread?text=…, mozhi://dictionary?word=gato&from=es
                 or mozhi://pair?code=… (the QR code of Phone to phone).
                 The <data> elements of one filter combine, so this matches
                 scheme "mozhi" with any of the listed hosts. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="mozhi"/>
                <data android:host="translate"/>
                <data android:host="image"/>
                <data android:host="conversation"/>
                <data android:host="proofread"/>
                <data android:host="documents"/>
                <data android:host="web"/>
                <data android:host="dictionary"/>
                <data android:host="pair"/>
            </intent-filter>
        </activity>
        <!-- Text selection toolbar: "Translate with Mozhi". A translucent
             window (QuickTranslateActivity.kt, a MainActivity) that shows
             only the quick translate sheet above the calling app and closes
             with it; Replace hands the translation back to the caller. In
             the caller's task (started for a result), and left out of
             recents should a caller start it as a task of its own. Its own
             Flutter engine starts at the route /quick-translate; deep links
             are not handled here. -->
        <activity
            android:name=".QuickTranslateActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/TransparentTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/TransparentTheme"
                />
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter android:label="@string/translate_with_mozhi">
                <action android:name="android.intent.action.PROCESS_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Share sheet: "Share" text, an image or a text document to Mozhi.
             An invisible window (ShareReceiverActivity.kt) that copies a
             shared file into the app's cache and opens MainActivity at the
             image screen (image/*) or the document translator (subtitles,
             text, Markdown, JSON, office files, e-books and PDFs; text/*
             includes text/vtt), or hands shared
             text on as before. Only content:// files of other apps are
             read. Nothing is translated or sent because of a share. -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/TransparentTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/*"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="application/x-subrip"/>
                <data android:mimeType="application/json"/>
                <!-- Office documents and e-books (Documents, W6-A). -->
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
                <data android:mimeType="application/vnd.oasis.opendocument.text"/>
                <data android:mimeType="application/vnd.oasis.opendocument.presentation"/>
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet"/>
                <data android:mimeType="application/epub+zip"/>
                <!-- PDF documents (Documents, W7-B). -->
                <data android:mimeType="application/pdf"/>
            </intent-filter>
        </activity>
        <!-- "Translate clipboard" entry point (MainActivity action
             TRANSLATE_CLIPBOARD). Not exported, so only Mozhi's own
             components can start it: the Quick Settings tile, the widget's
             PendingIntent and the static launcher shortcut (shortcuts are
             launched with the publishing app's identity, see
             LauncherAppsService.startShortcut: "the target activity doesn't
             have to be exported"). MainActivity ignores the action when it
             arrives through any other component, because MainActivity itself
             is exported. Aliases don't inherit the target's meta-data
             (FlutterActivity reads it for the started component), so the
             Flutter ones are repeated here. -->
        <activity-alias
            android:name=".TranslateClipboardActivity"
            android:targetActivity=".MainActivity"
            android:exported="false">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
                />
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />
        </activity-alias>
        <!-- Text selection toolbar: "Translate offline", a second
             PROCESS_TEXT entry that translates the selection with the
             on-device engine only, whatever the privacy mode, in the same
             translucent window as "Translate with Mozhi" (whose theme an
             alias takes). MainActivity adds action "translateOffline" to
             selections arriving through this alias (isTranslateOffline).
             Exported, because other apps start it from their selection
             toolbar; reaching it directly can only make a request more
             private. Aliases don't inherit the target's meta-data (see
             .TranslateClipboardActivity), so the Flutter ones are repeated
             here. -->
        <activity-alias
            android:name=".TranslateOfflineActivity"
            android:targetActivity=".QuickTranslateActivity"
            android:exported="true"
            android:label="@string/translate_offline">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/TransparentTheme"
                />
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter android:label="@string/translate_offline">
                <action android:name="android.intent.action.PROCESS_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity-alias>
        <!-- Quick Settings tile "Translate": opens Mozhi and translates the
             clipboard (through .TranslateClipboardActivity). -->
        <service
            android:name=".TranslateTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_translate"
            android:label="@string/tile_translate_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
        <!-- Translate screen: a translucent window (ScreenTranslateActivity.kt,
             a MainActivity with its own Flutter engine at the route
             /screen-translate) that asks for the screen-capture consent,
             takes one screenshot through ScreenCaptureService and draws its
             translation over it. Started only by Mozhi's own tile, bubble
             and launcher shortcut (not exported), in a task of its own that
             stays out of recents. -->
        <activity
            android:name=".ScreenTranslateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/TransparentTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/TransparentTheme"
                />
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
        </activity>
        <!-- The bubble's long press: an invisible window that reads the
             clipboard once it has focus and opens it in the quick translate
             window (BubbleClipboardActivity.kt). Not exported. -->
        <activity
            android:name=".BubbleClipboardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/TransparentTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />
        <!-- The one-shot screenshot of Translate screen (a media projection,
             stopped right after one frame). Not exported. -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!-- Live captions (LiveCaptionService.kt): other apps' sound through
             a media projection (AudioPlaybackCapture, Android 10+, after the
             capture consent asked every time; RECORD_AUDIO at run time),
             captioned in an overlay bar (Display over other apps). Audio
             only, in memory. Not exported. -->
        <service
            android:name=".LiveCaptionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!-- The opt-in translate bubble over other apps (Display over other
             apps). Not exported; stopped from its notification, the
             settings or by dragging it onto ×. -->
        <service
            android:name=".TranslateBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A floating button the user turned on, shown over other apps until they stop it: a tap translates the screen (after the system's screen-capture consent), a long press the clipboard." />
        </service>
        <!-- Quick Settings tile "Translate screen" (TranslateScreenTileService):
             opens ScreenTranslateActivity. -->
        <service
            android:name=".TranslateScreenTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_translate_screen"
            android:label="@string/tile_translate_screen_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
        <!-- Home-screen widget "Mozhi": Translate clipboard / Type / Camera
             buttons that open MainActivity (the clipboard button through
             .TranslateClipboardActivity) with the tile's and shortcuts'
             intents. Not exported: only the system (AppWidgetManager) sends
             it broadcasts. -->
        <receiver
            android:name=".MozhiWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mozhi_widget_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Package visibility (Android 11+), see
         https://developer.android.com/training/package-visibility -->
    <queries>
        <!-- Browsers, for links (url_launcher: canLaunchUrl and
             supportsLaunchMode need these; launchUrl itself starts the
             browser without them). http too: the web page translator opens
             pages on the local network ("Open original"). One <intent> per
             scheme: in <queries>, an <intent> may name only one scheme. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <!-- Used by the Flutter engine (io.flutter.plugin.text.ProcessTextPlugin)
             to list apps that can process selected text. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Sharing text (share_plus). -->
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Speech recognizers (speech_to_text). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Text-to-speech engines (flutter_tts). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- Camera apps for camera translate (image_picker). -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
</manifest>
