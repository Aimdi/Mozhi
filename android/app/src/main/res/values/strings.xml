<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Label of the text selection action (ACTION_PROCESS_TEXT). -->
    <string name="translate_with_mozhi">Translate with Mozhi</string>
    <!-- Label of the second text selection action, which translates on the
         device only (.TranslateOfflineActivity). Keep it short: the
         selection toolbar truncates long labels. -->
    <string name="translate_offline">Translate offline</string>

    <!-- Quick Settings tile (TranslateTileService). -->
    <string name="tile_translate_label">Translate</string>
    <string name="tile_translate_description">Translate the clipboard with Mozhi</string>

    <!-- Static launcher shortcuts (res/xml/shortcuts.xml). Short labels should
         stay within about 10 characters, long labels within about 25. -->
    <string name="shortcut_clipboard_short">Clipboard</string>
    <string name="shortcut_clipboard_long">Translate clipboard</string>
    <string name="shortcut_dictionary_short">Dictionary</string>
    <string name="shortcut_dictionary_long">Dictionary</string>
    <string name="shortcut_conversation_short">Conversation</string>
    <string name="shortcut_conversation_long">Conversation</string>
    <string name="shortcut_proofread_short">Proofread</string>
    <string name="shortcut_proofread_long">Proofread</string>

    <!-- Home-screen widget (MozhiWidgetProvider, xml/mozhi_widget_info.xml).
         Button labels are short (they share one row); the descriptions are
         read by screen readers. -->
    <string name="widget_label">Mozhi</string>
    <string name="widget_description">Translate the clipboard, type text or translate with the camera</string>
    <string name="widget_clipboard_label">Clipboard</string>
    <string name="widget_clipboard_description">Translate clipboard</string>
    <string name="widget_type_label">Type</string>
    <string name="widget_type_description">Type text to translate</string>
    <string name="widget_camera_label">Camera</string>
    <string name="widget_camera_description">Camera translate</string>

    <!-- Translate screen (ScreenTranslateActivity): the Quick Settings tile
         (TranslateScreenTileService), the launcher shortcut, the
         foreground notifications and the bubble (TranslateBubbleService).
         The tile label stays short; the bubble description is what screen
         readers announce for it. -->
    <string name="tile_translate_screen_label">Translate screen</string>
    <string name="tile_translate_screen_description">Translate what is on the screen with Mozhi</string>
    <string name="shortcut_translate_screen_short">Screen</string>
    <string name="shortcut_translate_screen_long">Translate screen</string>
    <string name="notification_channel_screen_capture">Screen translation</string>
    <string name="notification_channel_screen_capture_description">Shown for a moment while Mozhi takes the screenshot to translate</string>
    <string name="notification_screen_capture_title">Reading the screen</string>
    <string name="notification_channel_bubble">Translate bubble</string>
    <string name="notification_channel_bubble_description">Shown while the translate bubble is on</string>
    <string name="notification_bubble_title">Translate bubble is on</string>
    <string name="notification_bubble_text">Tap the bubble to translate the screen, hold it to translate the clipboard.</string>
    <string name="notification_bubble_stop">Stop</string>
    <string name="bubble_description">Translate screen</string>
    <string name="bubble_long_press_action">Translate clipboard</string>
    <string name="bubble_remove_action">Remove the bubble</string>
    <string name="bubble_remove_target">Remove</string>
    <string name="bubble_clipboard_empty">The clipboard is empty</string>

    <!-- Live captions of other apps' sound (LiveCaptionService): its
         notification channel and notification, the caption bar's Stop and
         Open buttons (read by screen readers) and the bar's own name. -->
    <string name="live_captions_channel">Live captions</string>
    <string name="live_captions_channel_description">Shown while Mozhi captions the sound of other apps</string>
    <string name="live_captions_notification_title">Live captions are on</string>
    <string name="live_captions_notification_text">Mozhi captions the sound other apps play. Nothing is recorded or saved.</string>
    <string name="live_captions_stop">Stop</string>
    <string name="live_captions_stop_description">Stop live captions</string>
    <string name="live_captions_open_description">Open Mozhi</string>
    <string name="live_captions_bar_description">Live captions</string>
    <string name="tile_live_captions_label">Live captions</string>
    <string name="tile_live_captions_description">Start or stop Mozhi\'s live captions</string>
    <string name="live_captions_locked">Mozhi is locked</string>
</resources>
