<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch screen and system bars until the app draws
         (drawable/launch_background.xml, styles.xml): white by day like the
         app's light look (lib/app/theme.dart AppTones.light), black at night
         (values-night/colors.xml). -->
    <color name="launch_background">#FFFFFFFF</color>
    <color name="launch_image">#FF000000</color>

    <!-- Launcher shortcut icons: the app's default seed colour (indigo) behind
         a white glyph. -->
    <color name="shortcut_icon_background">#FF3F51B5</color>
    <color name="shortcut_icon_glyph">#FFFFFFFF</color>
</resources>
