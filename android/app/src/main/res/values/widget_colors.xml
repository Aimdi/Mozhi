<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (MozhiWidgetProvider) colours, light theme, before
     Android 12: Material 3 tones of the app's default seed colour (indigo).
     values-night/ holds the dark variant; values-v31/ and values-night-v31/
     switch to the wallpaper-based system palette (Material You). -->
<resources>
    <!-- surfaceContainer -->
    <color name="widget_background">#FFF0EFF7</color>
    <!-- primaryContainer / onPrimaryContainer -->
    <color name="widget_button">#FFDEE0FF</color>
    <color name="widget_on_button">#FF0F1A5C</color>
    <color name="widget_ripple">#1F0F1A5C</color>
</resources>
