<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-to-device transfer rules for Android 12+ (API 31+);
     Android 11 and lower use backup_rules.xml.

     Everything else (settings and translation history in the
     SharedPreferences/DataStore files) is backed up so a new phone or a
     reinstall keeps them. Excluded: flutter_secure_storage's preference files,
     which hold the AI provider API keys. Their values are encrypted with
     AndroidKeyStore keys that never leave the device, so restored copies
     could not be decrypted (InvalidKeyException) and would only leak
     ciphertext into the backup. Users re-enter API keys after a restore.
     File names are the plugin defaults (no custom sharedPreferencesName /
     storageNamespace in lib/bootstrap.dart). -->
<data-extraction-rules>
    <!-- Only back up to the cloud when the backup is end-to-end encrypted
         (requires a screen lock). -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
