<?xml version="1.0" encoding="utf-8"?>
<!-- Mozhi is a client for self-hosted servers: Mozhi instances and local AI
     runtimes (Ollama, LM Studio, llama.cpp) are commonly reached over plain
     http on the LAN, so cleartext stays permitted.

     Release builds trust the system CAs only (reviews/security.md W8): a
     user-, MDM- or malware-installed CA must not be able to intercept TLS to
     every host (api.openai.com, api.anthropic.com, model downloads, ...).
     User CAs are trusted in debuggable builds only (debug-overrides), e.g. to
     inspect traffic with a proxy during development.

     This file governs platform networking (Java/Kotlin, plugins). Dart's
     HttpClient (package:http IOClient) loads only the system trust store and
     ignores this file, including cleartextTrafficPermitted; the app-level
     http guard is the real control for Dart traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <!-- User-installed CAs, debug builds only. -->
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
