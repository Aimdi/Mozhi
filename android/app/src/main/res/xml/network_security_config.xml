<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds trust the system CAs only (reviews/security.md W8): a
     user-, MDM- or malware-installed CA must not be able to intercept TLS to
     every host (api.openai.com, api.anthropic.com, model downloads, ...).
     User CAs are trusted in debuggable builds only (debug-overrides), e.g. to
     inspect traffic with a proxy during development.

     This file governs platform networking (Java/Kotlin, plugins such as ML
     Kit model downloads), none of which needs plain http, so cleartext is
     off. Dart's HttpClient (package:http IOClient) ignores this file,
     including cleartextTrafficPermitted and the trust anchors. For Dart
     traffic the control is the app's network policy
     (lib/core/network/network_policy.dart, BackendHttpClient): before
     anything is sent it refuses plain http to any host that is not this
     device, a private network, a .onion or a .i2p address. The Mozhi,
     LibreTranslate, DeepL and AI provider clients only follow redirects
     through it, never from https to http. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <!-- User-installed CAs, debug builds only. -->
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
