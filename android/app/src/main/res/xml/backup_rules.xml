<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 11 and lower (android:fullBackupContent);
     Android 12+ uses data_extraction_rules.xml. With android:allowBackup="false"
     nothing is backed up or transferred on these versions; the rules only keep
     API keys (flutter_secure_storage, encrypted with device-bound AndroidKeyStore
     keys) and history/settings (shared_preferences DataStore) out of backups
     should allowBackup ever be turned back on. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    <exclude domain="file" path="datastore" />
</full-backup-content>
