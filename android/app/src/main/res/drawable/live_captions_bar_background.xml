<?xml version="1.0" encoding="utf-8"?>
<!-- The caption bar of live captions (LiveCaptionService): a dark rounded
     panel with a thin light edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/live_captions_background" />
    <stroke
        android:width="1dp"
        android:color="@color/live_captions_border" />
    <corners android:radius="16dp" />
</shape>
