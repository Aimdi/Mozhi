<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget colours, light theme, Android 12+: dynamic
     (wallpaper-based) system palette, mapped like Material 3's
     surfaceContainer / primaryContainer / onPrimaryContainer. -->
<resources>
    <color name="widget_background">@android:color/system_neutral1_50</color>
    <color name="widget_button">@android:color/system_accent1_100</color>
    <color name="widget_on_button">@android:color/system_accent1_900</color>
    <color name="widget_ripple">#1F000000</color>
</resources>
